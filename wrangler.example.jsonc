{
  "name": "nadege-renard",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nadege-renard-db",
      "database_id": "REMPLACER_PAR_ID_D1",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "nadege-renard-media"
    }
  ],
  "send_email": [{ "name": "EMAIL" }]
}
